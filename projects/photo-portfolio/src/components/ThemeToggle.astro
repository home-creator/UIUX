---
// Switches between the dark and light rooms. The choice is remembered;
// until one is made, the site follows the visitor's system setting.
---

<button type="button" class="theme-toggle inline-grid size-11 place-items-center text-fg/90 transition-colors duration-200 hover:text-accent" data-theme-toggle aria-label="Switch to light theme">
  <!-- Shown in the dark theme: a sun (go light). -->
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <circle cx="9" cy="9" r="3.5" stroke="currentColor" stroke-width="1.1"></circle>
    <path d="M9 1v2M9 15v2M1 9h2M15 9h2M3.3 3.3l1.4 1.4M13.3 13.3l1.4 1.4M3.3 14.7l1.4-1.4M13.3 4.7l1.4-1.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path>
  </svg>
  <!-- Shown in the light theme: a moon (go dark). -->
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
    <path d="M15.5 11.2A6.8 6.8 0 0 1 6.8 2.5a6.8 6.8 0 1 0 8.7 8.7Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
      btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
    });
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', light ? '#f3eee6' : '#0f0e0c');
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
  });

  // Follow the system setting live, unless the visitor has chosen a theme.
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) {
      root.dataset.theme = e.matches ? 'light' : 'dark';
      sync();
    }
  });

  sync();
</script>

<style>
  :global(:root[data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }
</style>
