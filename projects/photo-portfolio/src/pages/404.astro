---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="mx-auto flex min-h-[60vh] max-w-[1440px] flex-col justify-center px-5 py-24 sm:px-8 lg:px-12">
    <p class="eyebrow mb-6">404</p>
    <h1 class="font-display text-[clamp(2.5rem,7vw,5.5rem)] leading-none font-normal tracking-[-0.02em]">
      This frame was <em class="text-brass">never developed.</em>
    </h1>
    <a href="/" class="link mt-10 inline-flex min-h-11 items-center self-start text-sm">Back to the work</a>
  </section>
</Base>
