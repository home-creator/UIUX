---
import Base from '../layouts/Base.astro';
import CldImage from '../components/CldImage.astro';
import Emphasis from '../components/Emphasis.astro';
import { site } from '../lib/config';
const { about, contact } = site;
const fill = (t: string) => t.replaceAll('{name}', site.name).replaceAll('{base}', site.base);
---

<Base title="About" ogImage={about.portrait.id}>
  <div class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
    <section class="grid gap-12 pt-20 pb-24 md:grid-cols-12 md:gap-12 md:pt-32 md:pb-36" aria-labelledby="about-title">
      <div class="md:col-span-5" data-reveal>
        <CldImage id={about.portrait.id} alt={about.portrait.alt} ratio="4:5" tone={about.portrait.tone} sizes="(min-width: 768px) 40vw, 100vw" priority />
      </div>

      <div class="md:col-span-6 md:col-start-7 md:pt-8" data-reveal style="--delay:150ms">
        <p class="eyebrow mb-8">About</p>
        <h1 id="about-title" class="font-display text-[clamp(2.25rem,5vw,4.25rem)] leading-[1.02] font-normal tracking-[-0.02em]">
          <Emphasis text={about.headline} />
        </h1>
        <div class="mt-10 space-y-5 text-lg leading-relaxed text-fg/85">
          {about.bio.map((para) => <p>{fill(para)}</p>)}
        </div>

        <dl class="mt-14 grid grid-cols-2 gap-x-8 gap-y-8 border-t border-line pt-10 text-sm">
          <div>
            <dt class="eyebrow mb-2">Based in</dt>
            <dd>{site.base}</dd>
          </div>
          <div>
            <dt class="eyebrow mb-2">Available for</dt>
            <dd>{about.availableFor}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="border-t border-line py-20 md:py-28" aria-labelledby="clients-title" data-reveal>
      <div class="grid gap-10 md:grid-cols-12">
        <h2 id="clients-title" class="eyebrow md:col-span-3">Selected clients</h2>
        <ul class="grid grid-cols-2 gap-x-8 gap-y-5 font-display text-2xl md:col-span-9 md:grid-cols-3 md:text-3xl">
          {about.clients.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </section>

    <section id="contact" class="scroll-mt-8 border-t border-line py-24 md:py-36" aria-labelledby="contact-title" data-reveal>
      <div class="grid gap-10 md:grid-cols-12">
        <p class="eyebrow md:col-span-3">Contact</p>
        <div class="md:col-span-9">
          <h2 id="contact-title" class="font-display text-[clamp(2rem,4vw,3.5rem)] leading-[1.05] font-normal tracking-[-0.02em]">
            {contact.heading}
          </h2>
          <a
            href={`mailto:${site.email}`}
            class="link mt-10 inline-flex min-h-12 items-center font-display text-[clamp(1.5rem,3.5vw,2.75rem)] italic text-accent"
          >
            {site.email}
          </a>
          <p class="mt-6 max-w-md text-muted">{contact.note}</p>
        </div>
      </div>
    </section>
  </div>
</Base>
