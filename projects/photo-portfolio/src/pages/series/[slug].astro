---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import CldImage from '../../components/CldImage.astro';
import Lightbox from '../../components/Lightbox.astro';
import { series, type Series } from '../../data/series';

export const getStaticPaths = (() =>
  series.map((s, i) => ({
    params: { slug: s.slug },
    props: { s, index: i, next: series[(i + 1) % series.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  s: Series;
  index: number;
  next: Series;
}

const { s, index, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// Where each frame sits on the 12-column grid, and where its caption goes.
const layout = {
  full: { frame: 'col-span-12 -mx-5 sm:-mx-8 lg:-mx-12', caption: 'col-span-12 md:col-span-6' },
  wide: { frame: 'col-span-12 md:col-span-10 md:col-start-2', caption: 'col-span-12 md:col-span-6 md:col-start-2' },
  left: { frame: 'col-span-12 md:col-span-6', caption: 'col-span-12 md:col-span-3 md:col-start-8 md:self-end' },
  right: { frame: 'col-span-12 md:col-span-6 md:col-start-7', caption: 'col-span-12 md:col-span-3 md:col-start-2 md:row-start-1 md:self-end' },
} as const;

const sizes = {
  full: '100vw',
  wide: '(min-width: 768px) 84vw, 100vw',
  left: '(min-width: 768px) 50vw, 100vw',
  right: '(min-width: 768px) 50vw, 100vw',
};
---

<Base title={s.title} description={s.summary} ogImage={s.cover.id}>
  <!-- The series' own colour cast washes the top of the page. -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[80vh]"
    style={`background:radial-gradient(120% 100% at 50% 0%, ${s.tone}66, transparent 100%)`}
    aria-hidden="true"
  >
  </div>

  <article class="mx-auto max-w-[1440px] px-5 sm:px-8 lg:px-12">
    <header class="grid gap-10 pt-20 pb-20 md:grid-cols-12 md:pt-32 md:pb-32">
      <div class="md:col-span-8" data-reveal>
        <p class="eyebrow mb-8">
          Nº {pad(index + 1)} <span class="mx-2 text-line">/</span>
          {s.place}, {s.year}
        </p>
        <h1 class="font-display text-[clamp(3rem,10vw,8.5rem)] leading-[0.9] font-normal tracking-[-0.03em]">
          {s.title}
        </h1>
      </div>
      <div class="md:col-span-4 md:self-end" data-reveal style="--delay:150ms">
        <p class="max-w-sm text-lg leading-relaxed text-paper/85">{s.summary}</p>
        <p class="eyebrow mt-8">{pad(s.photos.length)} photographs</p>
      </div>
    </header>

    <div class="flex flex-col gap-24 md:gap-40">
      {
        s.photos.map((p, i) => (
          <figure class="grid grid-cols-12 gap-x-6 gap-y-5" data-reveal>
            <div class={layout[p.span].frame}>
              <button
                type="button"
                class="group block w-full cursor-zoom-in overflow-hidden text-left"
                data-lightbox-index={i}
                aria-label={`View larger: ${p.alt}`}
              >
                <CldImage
                  id={p.id}
                  alt={p.alt}
                  ratio={p.ratio}
                  tone={p.tone}
                  sizes={sizes[p.span]}
                  priority={i === 0}
                  imgClass="group-hover:scale-[1.015]"
                />
              </button>
            </div>
            <figcaption class:list={['flex gap-4 text-sm text-ash', layout[p.span].caption]}>
              <span class="eyebrow shrink-0 text-brass">{pad(i + 1)}</span>
              {p.caption && <span>{p.caption}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <!-- Next series -->
    <nav class="mt-32 border-t border-line py-20 md:mt-48 md:py-28" aria-label="Next series">
      <a href={`/series/${next.slug}`} class="group grid items-center gap-8 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="eyebrow mb-6">Next series</p>
          <p class="font-display text-[clamp(2.5rem,7vw,6rem)] leading-none font-normal tracking-[-0.03em] transition-colors duration-300 group-hover:text-brass">
            {next.title}
            <svg width="44" height="20" viewBox="0 0 44 20" fill="none" aria-hidden="true" class="ml-3 inline-block align-middle transition-transform duration-500 group-hover:translate-x-2">
              <path d="M0 10h41M33 2l8 8-8 8" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </p>
          <p class="eyebrow mt-6">{next.place}, {next.year}</p>
        </div>
        <div class="overflow-hidden md:col-span-4 md:col-start-9">
          <CldImage id={next.cover.id} alt="" ratio="3:2" tone={next.cover.tone} sizes="(min-width: 768px) 33vw, 100vw" imgClass="group-hover:scale-[1.03]" />
        </div>
      </a>
    </nav>
  </article>

  <Lightbox photos={s.photos} title={s.title} />
</Base>
